rules_version = '2';
// Firestore қауіпсіздік ережелері: кім қандай деректі оқи/жаза алатынын бұлттың өзі тексереді
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Пайдаланушылар профилі
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
    }

    // Тапсырмаларды тек мұғалім жариялайды және өшіреді
    match /assignments/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && role() == 'teacher'
                    && request.resource.data.teacherId == request.auth.uid;
      allow delete: if signedIn() && resource.data.teacherId == request.auth.uid;
    }

    // Жауаптарды студент жібереді, ал тек өз мұғалімі бағалайды
    match /submissions/{id} {
      allow read: if signedIn()
                  && (resource.data.studentId == request.auth.uid
                      || resource.data.teacherId == request.auth.uid);
      allow create: if signedIn() && role() == 'student'
                    && request.resource.data.studentId == request.auth.uid;
      allow update: if signedIn() && resource.data.teacherId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['grade']);
    }
  }
}
